#!/usr/bin/env python3
"""
Tiny localhost proxy that exposes safe host-side desktop operations to the
sandboxed opencode agent. Listens only on 127.0.0.1.

Endpoints:
    GET /clipboard   → wl-paste image/png from the host clipboard, returns PNG bytes
                       (404 if clipboard has no image)
    GET /screenshot  → grim -g $(slurp) — user drags a region, returns PNG bytes
                       (interactive: prompts user via slurp; 408 on cancel)
    GET /healthz     → "ok"
    GET /speak-on    → "on" or "off": whether spoken replies are switched on, for
                       claude-speak hooks running in a sandbox that can't see the setting
    POST /speak      → JSON {"reply", "prompt", "rewriter", "kind"} handed to ~/.bin/voice/claude-speak
                       (the voice tools, a separate repo; 503 when they aren't installed),
                       which speaks a summary ("final") or a one-line progress update
                       ("progress") if speech is toggled on (202).
                       Used by the opencode speak plugin; the sandbox has no audio.
                       With "kind": "session", claude-speak only records what an agent
                       session is doing (~/.bin/voice/sessions.py), even with speech off.

The agent reaches this via `curl http://127.0.0.1:7878/clipboard > /tmp/x.png`,
then delegates to the vision subagent. No Wayland socket bound into the sandbox.

Run as a user systemd service for persistence (see oc-host-proxy.service).
"""
import http.server
import json
import logging
import os
import socketserver
import subprocess
import sys

LOG = logging.getLogger("oc-host-proxy")
PORT = 7878
HOST = "127.0.0.1"
SPEAKER = os.path.expanduser("~/.bin/voice/claude-speak")
SPEAKER_LOG = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "claude-speak.log")
SPEECH_FLAG = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "voice", "speak-on")


def run(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, timeout=timeout)


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        LOG.info("%s - " + fmt, self.address_string(), *args)

    def _png(self, data: bytes) -> None:
        self.send_response(200)
        self.send_header("Content-Type", "image/png")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _err(self, code: int, msg: str) -> None:
        self.send_error(code, msg)

    def _host_ok(self) -> bool:
        # Defense against DNS-rebinding: a browser/page can resolve an
        # attacker domain to 127.0.0.1 and POST to us, but the Host header it
        # sends is the attacker's domain, not a loopback literal. Reject anything
        # that isn't an explicit loopback host:port. Trips /screenshot (slurp)
        # and /speak otherwise — an attacker could pop the region selector on
        # the host, or make it talk.
        host = self.headers.get("Host", "")
        hostname = host.rsplit(":", 1)[0].strip("[]")  # drop :port, strip IPv6 []
        if hostname in ("127.0.0.1", "localhost", "::1"):
            return True
        self._err(403, "forbidden host header")
        return False

    def do_GET(self) -> None:  # noqa: N802
        if not self._host_ok():
            return
        if self.path == "/healthz":
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"ok\n")
            return

        if self.path == "/speak-on":
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"on\n" if os.path.exists(SPEECH_FLAG) else b"off\n")
            return

        if self.path == "/clipboard":
            try:
                types = run(["wl-paste", "--list-types"], timeout=5)
                if b"image/png" not in types.stdout:
                    self._err(404, "clipboard has no image/png")
                    return
                r = run(["wl-paste", "--type", "image/png"], timeout=10)
                if r.returncode != 0 or not r.stdout:
                    self._err(500, f"wl-paste failed: {r.stderr.decode()[:200]}")
                    return
                self._png(r.stdout)
            except subprocess.TimeoutExpired:
                self._err(504, "wl-paste timed out")
            except FileNotFoundError:
                self._err(500, "wl-paste not installed on host")
            return

        if self.path == "/screenshot":
            try:
                slurp = run(["slurp"], timeout=120)
                if slurp.returncode != 0:
                    self._err(408, "screenshot region selection cancelled")
                    return
                region = slurp.stdout.decode().strip()
                if not region:
                    self._err(408, "empty region from slurp")
                    return
                grim = run(["grim", "-g", region, "-"], timeout=10)
                if grim.returncode != 0 or not grim.stdout:
                    self._err(500, f"grim failed: {grim.stderr.decode()[:200]}")
                    return
                self._png(grim.stdout)
            except subprocess.TimeoutExpired:
                self._err(504, "screenshot tool timed out")
            except FileNotFoundError as e:
                self._err(500, f"missing tool: {e.filename}")
            return

        self._err(404, "unknown endpoint; use /clipboard, /screenshot, /healthz, /speak-on")

    def do_POST(self) -> None:  # noqa: N802
        if not self._host_ok():
            return
        if self.path != "/speak":
            self._err(404, "unknown endpoint; use POST /speak")
            return

        length = int(self.headers.get("Content-Length") or 0)
        if not 0 < length <= 1_000_000:
            self._err(413, "body must be between 1 byte and 1 MB")
            return
        try:
            job = json.loads(self.rfile.read(length))
            if not isinstance(job.get("reply"), str):
                raise ValueError("reply must be a string")
        except (ValueError, AttributeError) as e:
            self._err(400, f"invalid speak job: {e}")
            return

        if not os.access(SPEAKER, os.X_OK):
            self._err(503, "the voice tools (~/.bin/voice) aren't installed")
            return

        # Hand off and return at once; the speaker checks the on/off flag, rewrites and plays
        with open(SPEAKER_LOG, "ab") as out:
            speaker = subprocess.Popen(
                [SPEAKER, "say"],
                stdin=subprocess.PIPE,
                stdout=out,
                stderr=out,
                start_new_session=True,
            )
        speaker.stdin.write(json.dumps(job).encode())
        speaker.stdin.close()
        self.send_response(202)
        self.send_header("Content-Length", "0")
        self.end_headers()


def main() -> int:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(name)s %(levelname)s %(message)s",
    )
    LOG.info("listening on http://%s:%d", HOST, PORT)
    # Must be set before the constructor binds; setting it on the instance afterwards had no
    # effect, so a quick restart failed with "Address already in use" until old sockets expired
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer((HOST, PORT), Handler) as httpd:
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            LOG.info("shutting down")
    return 0


if __name__ == "__main__":
    sys.exit(main())
